# =====================================================================
# DienZt / DienstplanerAPI – Beispielkonfiguration
# Kopieren nach `.env` und Werte eintragen. `.env` NIEMALS committen.
# Alle Variablen ohne Standardwert müssen gesetzt sein, sonst bricht
# Django beim Start mit ImproperlyConfigured ab (auch für ungenutzte
# Mail-Relays: dann einen Dummy-Wert eintragen).
# =====================================================================

# --- Allgemein -------------------------------------------------------
# production  -> PostgreSQL, Redis-Container, *_DEPLOY-URLs, DEBUG=False
# alles andere -> SQLite, lokaler Redis, *_LOCAL-URLs, DEBUG=True
APP_ENV=development
# Image-Tag in docker-compose.yml (dienstplan_api:${APP_VERSION})
APP_VERSION=0.1.0

# --- URLs ------------------------------------------------------------
BASE_URL_LOCAL=http://127.0.0.1:8000/
FRONTEND_URL_LOCAL=http://localhost:5173/
# nur bei APP_ENV=production:
BASE_URL_DEPLOY=https://api.example.org
FRONTEND_URL_DEPLOY=https://app.example.org

# --- Hosts / CORS (Komma-getrennt) -----------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
# Produktion: Origins des Frontends inkl. Schema, ohne Pfad
# CSRF_TRUSTED_ORIGINS=https://app.example.org
# CORS_ALLOWED_ORIGINS=https://app.example.org

# --- Django ----------------------------------------------------------
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=change-me
# Datumsformat der Wunschdaten (strftime-Format, z. B. 31/12/2024)
DATEFORMAT_INPUT=%d/%m/%Y
# Erstes Admin-Konto (wird von `manage.py initadmin` nur angelegt, wenn
# noch kein Benutzer existiert)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me

# --- OAuth2-Client (Password-Grant) für das Frontend -----------------
# Wird per `manage.py createapplication` angelegt (docker-compose macht
# das beim Start automatisch). Muss mit den Werten im Frontend
# (src/user_store.ts) übereinstimmen.
CLIENT_ID=change-me
CLIENT_SECRET=change-me

# --- Datenbank (nur APP_ENV=production, docker-compose) --------------
POSTGRES_DB=dienzt
POSTGRES_USER=dienzt
POSTGRES_PASSWORD=change-me
# pgAdmin-Container (docker-compose, Port 8080 – nicht öffentlich exponieren!)
PGADMIN_DEFAULT_EMAIL=admin@example.org
PGADMIN_DEFAULT_PASSWORD=change-me

# --- privacyIDEA (optionale 2-Faktor-Authentifizierung, docker-compose)
PI_ADMIN_USER=admin
PI_ADMIN_PASSWORD=change-me
# Interne Schlüssel von privacyIDEA (zufällig erzeugen, nie ändern, solange Token existieren)
PI_SECRET_KEY=change-me
PI_PEPPER=change-me
# Statischer PIN-Anteil, den das Backend bei der OTP-Prüfung voranstellt
PI_OTP_PIN=change-me

# --- Verschlüsselung sensibler JSON-Felder ---------------------------
# Schlüssel mit `python manage.py generate_encryption_key` erzeugen
# (zweimal ausführen). Verlorene Schlüssel = unlesbare Daten!
ENC_KEY1=change-me
ENC_KEY2=change-me

# --- E-Mail-Versand --------------------------------------------------
# gmail   -> yagmail mit GMAIL_USERNAME/GMAIL_PASSWORD (App-Passwort)
# renecol -> eigener SMTP-Server (EMAIL_HOST*) mit DKIM-Signatur
EMAIL_RELAY=gmail
GMAIL_USERNAME=user@gmail.com
GMAIL_PASSWORD=change-me
EMAIL_HOST=smtp.example.org
EMAIL_HOST_USER=noreply@example.org
EMAIL_HOST_PASSWORD=change-me
EMAIL_FROM=noreply@example.org
# Pfad zum privaten DKIM-Schlüssel (liegt NICHT im Repository)
DKIM_PRIVATE_KEY_FILE=/code/dkim.private
DKIM_SELECTOR=selector

# --- Datenbank-Backup (django-dbbackup per FTP) ----------------------
# Format laut django-storages FTPStorage: ftp://user:passwort@host:21/pfad
FTP_BACKUP_CONNECTION=ftp://user:password@ftp.example.org:21/backups
